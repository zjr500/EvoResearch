{
  "name": "evoresearch-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "EvoResearch plugin for DeepSeek Harness",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./remote": {
      "types": "./dist/remote-plugin.d.ts",
      "default": "./dist/remote-plugin.js"
    }
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "cordis.remote.patch.example.yml",
    "config/ssh-hosts.example.json",
    "migrations/experiments/001_remote_hosts.sql",
    "scripts/migrate-remote.mjs",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "migrate:remote": "node scripts/migrate-remote.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dependencies": {
    "@deepseek-ai/dsh-ssh": "0.2.1-rc.2",
    "@deepseek-ai/dsh-subprocess-ssh": "0.2.1-rc.2",
    "better-sqlite3": "^13.2.0",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "typescript": "^5.9.0"
  }
}
