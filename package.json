{
  "name": "evoresearch-plugin",
  "version": "0.1.0",
  "private": true,
  "description": "EvoResearch plugin for DeepSeek Harness",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "modules/dialogue/dist",
    "cordis.patch.yml",
    "README.md",
    "migrations",
    "scripts/migrate.mjs"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.2 <0.3.0"
  },
  "scripts": {
    "build": "npm run build:dialogue && tsc -p tsconfig.json && node scripts/components.mjs build",
    "check": "npm run build:dialogue && tsc -p tsconfig.json --noEmit && node scripts/components.mjs check",
    "test": "npm run build && node --import tsx --test test/*.test.mjs test/*.test.ts && node scripts/components.mjs test",
    "db:migrate": "npm run build && node scripts/migrate.mjs",
    "build:dialogue": "tsc -p modules/dialogue/tsconfig.json"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-tools": "0.2.1-rc.2",
    "@deepseek-ai/schemastery": "^3.18.5"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "pdf-parse": "^2.4.5",
    "sqlite-vec": "^0.1.9"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
