# Relative paths resolve against the DSH process working directory.
# Prefer an absolute path shared by startup and migration commands.
# Export these values into the process environment; .env is not loaded automatically.
EVORESEARCH_DB_PATH=./data/evoresearch.sqlite

# Optional paired override. Leave BOTH empty to inherit DSH agentDefaultModel.
# Set BOTH to override; one alone is an error. API keys are managed only by DSH.
EVORESEARCH_SUMMARY_PROVIDER=
EVORESEARCH_SUMMARY_MODEL=

# Independent experiment-model selection, resolved through DSH (no API key here).
# Leave BOTH empty to inherit DSH. Explicit per-task choice can override these.
EVORESEARCH_EXPERIMENT_PROVIDER=
EVORESEARCH_EXPERIMENT_MODEL=
