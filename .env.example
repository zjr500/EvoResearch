# Copy to .env. Generate separate random values; never commit .env.
EVORESEARCH_TOKEN=
GRAPHITI_PASSWORD=
AUTORESEARCH_MODEL_API_KEY=
AUTORESEARCH_PROVIDER=openai_compatible
AUTORESEARCH_MODEL_BASE_URL=https://api.deepseek.com
AUTORESEARCH_MODEL=deepseek-v4-flash
AUTORESEARCH_RUNNER=local_trusted
AUTORESEARCH_HOME=./var
GRAPHITI_URI=bolt://127.0.0.1:17687
GRAPHITI_USER=neo4j
GRAPHITI_MODEL=deepseek-v4-flash
GRAPHITI_BASE_URL=https://api.deepseek.com
GRAPHITI_TELEMETRY_ENABLED=false
# Optional Zotero read access
ZOTERO_LIBRARY_TYPE=users
ZOTERO_LIBRARY_ID=
ZOTERO_API_KEY=
